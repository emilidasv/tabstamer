{
   "action": {
   
      "default_title": "Tabs Tamer"
   },
   "background": {
      "service_worker": "background.js",
      "type": "module"
   },
   "description": "Save all open tabs to a bookmarks folder and close the tabs",
   "icons": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
   },
   "manifest_version": 3,
   "name": "Tabs Tamer",


   
   "permissions": [ "bookmarks", "tabs" ],
   "version": "1.0.0"
}
